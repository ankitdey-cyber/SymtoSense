# Copy this file to `.env.local` (higher precedence) or `.env` for local development.
# Both files are loaded automatically by server.ts (.env.local first, then .env).

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Both newer "AQ." keys and older "AIza" keys from https://aistudio.google.com/apikey work.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model overrides (defaults shown below; auto-verified via ai.models.list() on startup).
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# APP_URL: The URL where this app is hosted (optional locally).
APP_URL="http://localhost:3000"
